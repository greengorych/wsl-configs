{
  "files.associations": {
    "*.meta-data": "yaml",
    "*.user-data": "yaml",
    "99_wsl.cfg": "yaml",
    ".wslconfig": "ini",
    ".wslgconfig": "ini",
    "wsl.conf": "ini",
    "wsl-distribution.conf": "ini",
  },
  "editor.detectIndentation": false,
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "[shellscript]": {
    "editor.tabSize": 4,
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  }
}
